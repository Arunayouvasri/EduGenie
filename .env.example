# Get your Gemini API key from Google AI Studio.
GEMINI_API_KEY=your_api_key_here

# Stable model used by default. Change if your API project has access to another model.
GEMINI_MODEL=gemini-3.8-flash

# Keep false for the lightweight cloud setup.
# Set true only after installing transformers + torch to use LaMini-Flan-T5-783M for explanations.
USE_LOCAL_EXPLAINER=false
